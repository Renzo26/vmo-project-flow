# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA faça commit do arquivo .env.

# OpenAI (módulo de análise de documentos)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Planilha modelo Padrão de Entrada PF (relativo à pasta backend)
# SFP usa TEMPLATE_PATH; APF e NESMA usam TEMPLATE_APF_PATH.
TEMPLATE_PATH=../Documentos_regras/Padrão de Entrada PF.xlsx
TEMPLATE_APF_PATH=../Documentos_regras/01_ENTRADA_PF_(APF).xlsx

# Banco de dados — Supabase Postgres (use o Session Pooler, porta 5432, IPv4)
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:5432/postgres

# Autenticação JWT
JWT_SECRET=troque-por-uma-chave-longa-com-pelo-menos-256-bits

# Supabase Storage (anexos / propostas) — gerar a Service Role Key em Settings > API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role-key...
SUPABASE_BUCKET=anexos

# CORS — origens do frontend separadas por vírgula
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
