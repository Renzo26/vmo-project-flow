# ─── Banco de dados ──────────────────────────────────────────────────────────
# Use o Session Pooler do Supabase (porta 5432, IPv4)
DATABASE_URL=postgresql+asyncpg://postgres.SEU_PROJECT_ID:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ─── OpenAI (análise de documentos PF) ───────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-uma-chave-segura-de-pelo-menos-256-bits

# ─── Supabase Storage (anexos e propostas) ───────────────────────────────────
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_BUCKET=anexos

# ─── CORS ────────────────────────────────────────────────────────────────────
# Em produção, informe o domínio do frontend atribuído pelo EasyPanel
CORS_ORIGINS=https://vmo.SEU_DOMINIO.easypanel.host

# ─── Nota: TEMPLATE_PATH ─────────────────────────────────────────────────────
# Definido automaticamente no docker-compose.yml como:
#   /app/Documentos_regras/Padrão de Entrada PF.xlsx
# (o arquivo é copiado da pasta Documentos_regras/ durante o build)
